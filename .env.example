# AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1

# EC2 configuration
AMI_ID=ami-xxxxxxxx
INSTANCE_TYPE=t2.micro
KEY_NAME=your-key-pair-name
SUBNET_ID=subnet-xxxxxxxx
VPC_ID=vpc-xxxxxxxx

# IAM instance profile with AmazonSSMManagedInstanceCore (for SSM Session Manager)
IAM_INSTANCE_PROFILE=your-ssm-instance-profile-name

# Optional: comma-separated security group IDs (leave empty to use default VPC SG)
SECURITY_GROUP_IDS=sg-xxxxxxxx

# Assign a public IP (true/false)
ASSOCIATE_PUBLIC_IP=true

# Optional
INSTANCE_NAME=my-ec2-instance
VOLUME_SIZE_GB=8
